{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "amarantha",
  "version": "0.1.0",
  "identifier": "com.franklinflitton.amarantha",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "amarantha",
        "width": 800,
        "height": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzMkRCNjBGRDE5NEI2RgpSV1J2U3huOVlOc3lCTkVhd3U2clFJYzFTeEhSOThGdEtVWUJDVjJSdmpsNXN6ZEczZHlUYVQwNAo=",
      "endpoints": ["https://github.com/FrankFlitton/amarantha-md-editor/releases/latest/download/latest.json"]
    }
  }
}
