{
  "name": "@amarantha/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:content && npm run build:content-lazy && npm run build:background && npm run build:options && npm run build:copy",
    "build:content": "vite build --config vite.content.config.ts",
    "build:content-lazy": "vite build --config vite.content-lazy.config.ts",
    "build:background": "vite build --config vite.background.config.ts",
    "build:options": "vite build --config vite.options.config.ts",
    "build:copy": "node scripts/copyStatic.mjs",
    "dev:options": "vite --config vite.options.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@amarantha/core": "*",
    "@amarantha/editor": "*",
    "@amarantha/mdx": "*",
    "@amarantha/source": "*",
    "@amarantha/theme": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/chrome": "^0.0.281",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
