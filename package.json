{
  "name": "amarantha",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri dev --workspace @amarantha/desktop",
    "dev:web": "npm run dev --workspace @amarantha/web",
    "build": "npm run build --workspace @amarantha/desktop",
    "build:vscode": "npm run build --workspace @amarantha/vscode",
    "build:extension": "npm run build --workspace @amarantha/extension",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
